# ============================================================================
# gibson-bootstrap-runner — chart's bootstrap-secrets Job container
# ============================================================================
# The chart's bootstrap-secrets Job runs a bash script that drives the
# gibson-bootstrap binary plus shells out to kubectl / aws-cli / jq. The
# `gibson-bootstrap` image is distroless (Go binary only) and has none of
# those tools, so the chart's Job command spec
# `command: ["/bin/bash", "/scripts/bootstrap.sh"]` crashed with
# `exec: "/bin/bash": no such file or directory`.
#
# This runner image layers the gibson-bootstrap binary onto an alpine base
# with bash + jq + curl + ca-certificates + aws-cli + kubectl. Used only
# by the chart's bootstrap-secrets Job; direct CLI use stays on the
# distroless `gibson-bootstrap` image.
#
# Spec: .spec-workflow/specs/kind-dashboard-bringup-e2e (D1).
#
# Build (from repo root):
#   docker buildx build \
#     -f tools/gibson-bootstrap/Dockerfile.runner \
#     -t ghcr.io/zeroroot-ai/gibson-bootstrap-runner:latest \
#     .
# ============================================================================

ARG BOOTSTRAP_TAG=latest

# Stage 1: pull the published gibson-bootstrap binary
FROM ghcr.io/zeroroot-ai/gibson-bootstrap:${BOOTSTRAP_TAG} AS bootstrap

# Stage 2: alpine runner with the tools the chart's bootstrap.sh needs
FROM ghcr.io/zeroroot-ai/mirror/alpine:3.21@sha256:48b0309ca019d89d40f670aa1bc06e426dc0931948452e8491e3d65087abc07d

# bash         — the chart's bootstrap.sh shebang + helper functions
# jq           — parse JSON output from `gibson-bootstrap zitadel-ensure-*`
# curl         — health checks; not used by the script today but commonly
#                added when extending it
# ca-certificates — for HTTPS to Zitadel and AWS
# aws-cli      — bootstrap-secrets `aws` backend (AWS Secrets Manager)
# kubectl      — bootstrap-secrets `kubernetes` backend (in-cluster Secret)
# APT_CACHE_BUST — make `apk upgrade` actually run.
#
# The base is digest-pinned, which fixes where the build starts and says nothing
# about currency: nothing here applied Alpine's own security updates between
# base bumps. And an upgrade on its own would not hold either, because this
# layer is cached by buildx (cache-from: type=gha) on instruction text plus base
# digest, so it would run once and be replayed forever.
#
# Measured 2026-09-16 on gibson-executor, by accident: a broken step in the org
# workflow briefly dropped cache-from/cache-to, and that one cache-less build
# produced fully patched packages. The next cached build put them straight back,
# and Trivy went from 0 OS findings to 40.
#
# The org reusable workflow passes APT_CACHE_BUST=${{ github.run_id }} to every
# build (.github#84), so declaring the ARG here is the whole opt-in. The name
# says APT because it is one shared arg for apt and apk alike.
ARG APT_CACHE_BUST=0
RUN echo "apk refresh ${APT_CACHE_BUST}" >/dev/null \
 && apk upgrade --no-cache \
 && apk add --no-cache \
        bash \
        jq \
        curl \
        ca-certificates \
        aws-cli \
        kubectl

COPY --from=bootstrap /gibson-bootstrap /usr/local/bin/gibson-bootstrap
# The first-admin Job needs both halves in one container: seed-first-admin
# enqueues the tenant provisioning op, then bootstrap-tenant-owner creates
# the owner in the org that op produced (deploy#1631).
COPY --from=bootstrap /bootstrap-tenant-owner /usr/local/bin/bootstrap-tenant-owner

# Elastic License 2.0, "Notices": anyone who gets a copy of the software
# must also get a copy of these terms. A container image is a copy.
# /licenses is the OCI convention for where that text lives.
COPY LICENSE /licenses/LICENSE

# Reset entrypoint so the chart's command:[/bin/bash, /scripts/bootstrap.sh]
# spec is honoured. Default CMD lands at bash if the chart is misconfigured,
# which surfaces faster than a silent no-op.
ENTRYPOINT []
CMD ["/bin/bash"]
