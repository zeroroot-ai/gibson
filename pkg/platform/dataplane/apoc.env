# apoc.env: the Neo4j APOC provisioning contract, rendered from the Go
# constants in pkg/platform/dataplane/apoc.go. Generated: run `make apoc-contract`.
# Read by zeroroot-ai/.github version-links.yaml, which keeps the chart's
# copies in zeroroot-ai/charts helm/gibson/values.yaml equal to these (gibson#28).
NEO4J_APOC_CORE_JAR_GLOB=/var/lib/neo4j/labs/apoc-*-core.jar
NEO4J_APOC_EXPORT_FILE_ENABLED=false
NEO4J_APOC_IMPORT_FILE_ENABLED=false
NEO4J_PLUGINS_DIR=/plugins
NEO4J_PROCEDURE_ALLOWLIST=apoc.merge.node,apoc.merge.relationship
