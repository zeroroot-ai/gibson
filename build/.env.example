# Gibson Development Environment Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# Langfuse LLM Observability (optional - uses local instance by default)
# For cloud Langfuse, get keys from https://cloud.langfuse.com
# =============================================================================
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# =============================================================================
# Local Development Settings
# =============================================================================
# Path to local tools for development (optional)
# HOST_TOOLS_PATH=/path/to/your/tools

