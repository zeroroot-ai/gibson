{
  "name": "security-test",
  "description": "Attack one target inside the scope that the tenant set, raise a finding for each proof, and report each finding with its proof, its technique and its replay.",
  "version": "1.0.0",
  "nodes": {
    "attack": {
      "id": "attack",
      "type": "NODE_TYPE_AGENT",
      "agentConfig": {
        "agentName": "red-agent",
        "task": {
          "id": "attack",
          "goal": "Test reference-environment at {{target.url}}. For each flaw that you can prove, call SubmitProof with the predicate of its technique and the recorded tool calls. Raise one finding for each proof that settles. Do not change the target and do not fix anything. Do not contact a host other than {{target.url}}. Before a destructive step, request authorization and wait for the decision.",
          "context": {
            "application": {
              "stringValue": "reference-environment"
            },
            "fix": {
              "stringValue": "never"
            },
            "red.task": {
              "stringValue": "security-test"
            },
            "report.contents": {
              "stringValue": "finding, proof, technique, replay"
            },
            "scope.name": {
              "stringValue": "{{target.name}}"
            },
            "scope.target": {
              "stringValue": "{{target.url}}"
            }
          }
        }
      }
    },
    "report": {
      "id": "report",
      "type": "NODE_TYPE_JOIN",
      "joinConfig": {
        "waitFor": [
          "attack"
        ],
        "strategy": "MERGE_STRATEGY_CONCAT"
      },
      "dependencies": [
        "attack"
      ]
    }
  },
  "edges": [
    {
      "from": "attack",
      "to": "report"
    }
  ],
  "entryPoints": [
    "attack"
  ],
  "exitPoints": [
    "report"
  ],
  "constraints": {
    "requireEvidence": true,
    "allowedTechniques": [
      "unauthenticated_endpoint_exposed",
      "credential_disclosure_detected",
      "privileged_container_detected",
      "node_token_readable",
      "rbac_write_access_proven"
    ]
  }
}
