# AUTHORITATIVE-FGA-MODEL
#
# This file is the authoritative, hand-maintained OpenFGA authorization model.
# It is applied to the FGA server by the gibson-fga-init Kubernetes Job on every
# helm install/upgrade (the chart embeds files/fga-model.json, regenerated from
# this file via `make sync-fga-model` -> cmd/gen-fga-model-json).
#
# Gibson Authorization Model
#
# This file is the single source of truth for the OpenFGA authorization model.
# It is applied to the FGA server by the gibson-fga-init Kubernetes Job on every
# helm install/upgrade. Changes here must pass CI (fga-smoke-test.yml) before merge.
#
# When extending, add new types after system_tenant. Do NOT rename existing
# relations or types — doing so breaks existing tuples in the FGA store.
#
# Spec: tenant-role-taxonomy
#
# MODEL SCOPE
# -----------
# user            — a human or service principal identified by UUID
# tenant          — a Gibson customer organization (slug-addressed)
# agent_principal — a per-agent identity for scoped capability grants (Agent Auth Protocol)
# component       — an agent, tool, or plugin registered in the Gibson component registry
# system_tenant   — a singleton object (system_tenant:_system) that models
#                   cross-tenant platform-operator privilege
# team            — a subdivision of a tenant for grouping users and controlling data access
#
# TENANT FOUR-TIER ROLE HIERARCHY (spec: tenant-role-taxonomy, ADR-0037)
# -----------------------------------------------------------------------
# The tenant type exposes four user-facing roles in a strict computed-union
# hierarchy. Roles are additive upward: an owner implicitly satisfies admin,
# writer, and member checks; an admin implicitly satisfies writer and member;
# a writer implicitly satisfies member.
#
#   owner  (highest) — founding user or explicitly-assigned owner.
#                      Direct tuple grant only: [user].
#                      Written by the tenant-owner-backfill Job on migration;
#                      written by the signup action for new tenants.
#
#   admin  (upper)   — tenant administrator.
#                      Direct grant OR inherited from owner via computed union.
#                      Definition: [user] or owner
#
#   writer (mid)     — tenant write-tier. Grants all write-path SDK RPCs
#                      (CreateProvider, SaveMissionDraft, CreateAgentIdentity,
#                      CreateMissionDefinition, etc.) without granting admin
#                      privilege. ADR-0037: "writer is a tenant-scoped permission
#                      level granted to tenant owners by design".
#                      Direct grant OR inherited from admin (which includes owner).
#                      Definition: [user] or admin
#
#   member (lowest)  — any authenticated tenant participant (read-only RPCs).
#                      Direct grant OR inherited from writer (which includes admin
#                      and owner).
#                      Definition: [user] or writer
#
# This means:
#   Check(user:alice, admin,  tenant:acme) → true  when alice is owner of acme
#   Check(user:alice, writer, tenant:acme) → true  when alice is owner or admin of acme
#   Check(user:alice, member, tenant:acme) → true  when alice is owner, admin, or writer
#   Check(user:bob,   owner,  tenant:acme) → false when bob is only admin of acme
#   Check(user:carol, writer, tenant:acme) → false when carol is only member of acme
#
# Existing tuples (owner/admin/member) are unaffected — no migration needed.
# No existing member check breaks: member still satisfies via writer→admin→owner chain.
#
# RELATION SEMANTICS
# ------------------
# tenant.owner        → user is the founding/highest-privilege user of the tenant
#                       (direct grant only; computed union propagates downward)
# tenant.admin        → user is an administrator of the tenant
#                       (direct grant OR inherited from owner via computed union)
# tenant.writer       → user has write-tier access (direct grant OR inherited from admin)
# tenant.member       → user is a member (direct grant OR inherited from writer,
#                       which by computed union includes admin and owner)
# tenant.active_session → session-validity gate: user holds a non-revoked session
#                         for this tenant. Direct [user with token_not_revoked] only;
#                         NOT part of the role hierarchy. Checked by ext-authz (Slice 2
#                         of gibson#627) on every authenticated request.
# agent_principal.owner      → user that owns/created this agent principal
# agent_principal.belongs_to → tenant this agent principal is scoped to
# component.owner     → a tenant owns this component
# component.can_execute  → user/agent_principal can run this component (direct grant OR via tenant membership)
# component.can_configure → user/agent_principal can modify this component's config (direct grant OR via tenant membership)
# component.can_read  → user/agent_principal can read this component's output/data (direct grant OR via tenant/team membership)
# system_tenant.platform_operator → user has cross-tenant elevated privilege
# team.parent         → the tenant this team belongs to
# team.admin          → user is an admin of the team (or inherits tenant admin)
# team.member         → user is a member of the team (includes team admins)
# team.can_view_data_from → team A has crosstalk visibility into team B's data
#
# Tuple examples (tenant four-tier hierarchy):
#   user:alice   | owner            | tenant:acme       (founding user; satisfies admin + writer + member)
#   user:bob     | admin            | tenant:acme       (satisfies writer + member; does NOT satisfy owner)
#   user:dave    | writer           | tenant:acme       (satisfies member; does NOT satisfy admin or owner)
#   user:carol   | member           | tenant:acme       (lowest role; does NOT satisfy writer, admin, or owner)
#
# Tuple examples (other types):
#   tenant:acme  | owner            | component:nmap
#   user:alice   | can_execute      | component:nmap    (computed: admin→member→can_execute)
#   user:root    | platform_operator | system_tenant:_system
#   team:ops     | parent           | tenant:acme
#   user:alice   | admin            | team:ops
#   user:bob     | member           | team:ops
#   team:alpha   | can_view_data_from | team:beta
#   user:alice        | owner      | agent_principal:agent-abc-123
#   tenant:acme       | belongs_to | agent_principal:agent-abc-123
#   agent_principal:agent-abc-123 | can_execute | component:nmap   (direct per-agent grant)
#   agent_principal:agent-abc-123 | cannot_invoke      | component:gitlab-plugin  (per-agent DENY override)
#   component:nmap-agent          | can_be_invoked_by  | component:scan-controller (explicit component→component invocation grant)
#   user:alice (with token_not_revoked{token_issued_at:T, revoked_at:T-1}) | active_session | tenant:acme   (session valid)
#   user:alice (with token_not_revoked{token_issued_at:T, revoked_at:T+1}) | active_session | tenant:acme   (session revoked)

# Cross-component relations (added for capability-manifest-rpc):
#   agent_principal.cannot_invoke    → explicit DENY on (agent, target_component); overrides positive can_execute.
#   component.can_be_invoked_by      → explicit ALLOW enabling the manifest builder to surface
#                                      component→component "may invoke" rules without enumerating
#                                      every (source, target) pair via Check.
# The effective cross-component rule resolution lives in FGABridge.ResolveCrossComponentRules:
#   DENY if cannot_invoke is true; else ALLOW if can_execute or can_be_invoked_by is true;
#   else absent (the default can_execute check remains the gate).

model
  schema 1.1

type user
  relations
    # active_session — USER-SCOPED session-validity gate for requests that name
    # no tenant (the sign-in bootstrap window). gibson#1244.
    #
    # tenant.active_session gates every request that names a tenant, but a
    # tenant-less request — a self-mode RPC from a caller that has selected no
    # active tenant yet — has no `type tenant` object to check, so the gate used
    # to pass it through. That left self-mode RPCs un-revocation-gated for as
    # long as the caller sent no tenant. This relation gives such a request a
    # revocation object keyed on the caller's OWN user object.
    #
    # Tuple shape (subject == object == the user):
    #   (user:<user_id>, active_session, user:<user_id>)
    #   condition: token_not_revoked{revoked_at: <epoch | revoked_at>}
    #
    # Written alongside the per-tenant tuple by the SAME writers
    # (authz.ActiveSessionUserTuple, cmd/active-session-backfill, the
    # tenant-member controller) and advanced by the SAME revocation path
    # (RevokeUserSessions stamps revoked_at=now on BOTH objects). Same
    # token_not_revoked condition as tenant.active_session.
    #
    # Direct [user with token_not_revoked] grant only; no computed-union path
    # into or from any other relation — identical zero-blast-radius shape to
    # tenant.active_session.
    #
    # Bootstrap distinction (checkSessionGate / fga.CheckUserSession): an ABSENT
    # tuple means a genuinely-first sign-in that has not been provisioned into
    # any tenant yet — that request is ALLOWED (denying it would make sign-in
    # unrecoverable). A PRESENT tuple whose condition fails means a REVOKED
    # session — that request is DENIED. The tenant-scoped gate is deny-on-absent;
    # this one is allow-on-absent, deny-on-revoked, by design.
    define active_session: [user with token_not_revoked]

type tenant
  relations
    define owner: [user]
    define admin: [user] or owner
    define writer: [user] or admin
    define member: [user, agent_principal, tool_principal, plugin_principal] or writer
    # active_session — session-validity gate checked directly by ext-authz
    # (Slice 2 of gibson#627). This relation is intentionally decoupled from
    # the owner/admin/writer/member hierarchy: it is a side-channel validity
    # predicate, not a role. ext-authz evaluates it on every authenticated
    # request; a deny here short-circuits authorization regardless of the
    # caller's tenant role.
    #
    # Tuple shape written by tenant-operator at session creation:
    #   (user:<user_id>, active_session, tenant:<tenant_id>)
    #   condition: token_not_revoked{token_issued_at: <session.IssuedAt>}
    #
    # When a session is revoked, the operator updates revoked_at in the
    # session record and passes the new value as Check context. No tuple
    # deletion is required — the condition evaluates to false automatically.
    #
    # Zero blast radius: this relation is a direct [user with token_not_revoked]
    # grant only; it has no computed-union path into or from any other relation.
    # Existing owner/admin/writer/member semantics are unaffected.
    #
    # Spec: instant-session-revocation (gibson#627 Slice 1).
    define active_session: [user with token_not_revoked]
    # Spec plans-and-quotas-simplification removed the has_* feature-flag
    # relations (has_sso / has_audit_logs / has_compliance_exports /
    # has_dedicated_slack / has_dedicated_tenant / has_private_registry).
    # None were enforced; the operator's tuple writers + plans.yaml fields
    # are deleted alongside.

type agent_principal
  relations
    define owner: [user]
    define belongs_to: [tenant]
    define cannot_invoke: [component]

# tool_principal — a per-tool machine identity provisioned via
# TenantAdminService.CreateAgentIdentity with kind=TOOL.
# Mirrors agent_principal shape. Spec: agent-service-credentials.
type tool_principal
  relations
    define owner: [user]
    define belongs_to: [tenant]
    define cannot_invoke: [component]

# plugin_principal — a per-plugin machine identity provisioned via
# TenantAdminService.CreateAgentIdentity with kind=PLUGIN.
# Mirrors agent_principal shape. Spec: agent-service-credentials.
type plugin_principal
  relations
    define owner: [user]
    define belongs_to: [tenant]
    define cannot_invoke: [component]

type component
  relations
    define owner: [tenant]
    # Ownership / publication scope (agent-authoring-and-tenant-entitlements R3):
    # platform_enabled — item is in the system-tenant's public catalog
    # tenant_published — item is in its owning tenant's private registry (org+ plans only)
    # tenant_enabled   — a given tenant has this item available (seeded per-tenant by operator)
    define platform_enabled: [system_tenant]
    define tenant_published: [tenant]
    define tenant_enabled: [tenant]
    # Tenant-level per-action denies — tenant-admin wholesale kill switches.
    define tenant_read_disabled: [tenant]
    define tenant_write_disabled: [tenant]
    define tenant_execute_disabled: [tenant]
    # Team-level per-action denies via team membership. Subject is team#member,
    # so a user in any team with a given deny set loses that action.
    define team_read_disabled: [team#member]
    define team_write_disabled: [team#member]
    define team_execute_disabled: [team#member]
    # User-level per-action denies — personal opt-out on My access UI.
    define user_read_disabled: [user]
    define user_write_disabled: [user]
    define user_execute_disabled: [user]
    # Component-scope per-action grants for component-principal narrowing
    # (owner approves at install time). Default absent = denied. Symmetric
    # across the three principal kinds (ADR-0046): capability is policy
    # (what enrollment grants per kind), not a type-system wall.
    define component_read_enabled: [agent_principal, tool_principal, plugin_principal]
    define component_write_enabled: [agent_principal, tool_principal, plugin_principal]
    define component_execute_enabled: [agent_principal, tool_principal, plugin_principal]
    # Effective per-action evaluators — existing relation names preserved so
    # call sites keep compiling. Each layers the ownership/scope gate onto
    # the direct grant set and subtracts every matching deny relation.
    # Deny-wins composition; denies are union-subtracted (union of any deny
    # at any layer => overall deny at that action class).
    # any_execute_deny / any_write_deny / any_read_deny collect all per-action
    # denies across scopes so the user-facing relations need a single `but not`.
    define any_execute_deny: member from tenant_execute_disabled or team_execute_disabled or user_execute_disabled
    define any_write_deny: member from tenant_write_disabled or team_write_disabled or user_write_disabled
    define any_read_deny: member from tenant_read_disabled or team_read_disabled or user_read_disabled
    # owner-side direct/role grant (pre-gate). Symmetric across the three
    # principal kinds (ADR-0046): a tool/plugin principal may be granted the
    # same component relations as an agent; what each kind actually receives is
    # enrollment policy, not a model restriction.
    define direct_execute: [user, agent_principal, tool_principal, plugin_principal, tenant#member, team#member] or member from owner
    define direct_configure: [user, agent_principal, tool_principal, plugin_principal, tenant#member, team#member] or member from owner
    define direct_read: [user, agent_principal, tool_principal, plugin_principal, tenant#member, team#member, team#can_view_data_from] or member from owner
    # Work-receive gate (ADR-0066). A component that polls its OWN dispatched
    # work (ComponentService.PollWork / SubmitResult) needs this grant, NOT the
    # platform-drive grant direct_execute. A plugin_principal is invoked-only for
    # DRIVING the platform (RunMission / CallTool stay on can_execute), but it
    # MUST receive its work — so a plugin holds direct_receive_work WITHOUT
    # direct_execute. agent/tool principals already hold direct_execute, which
    # satisfies can_poll_work below, so they are unchanged and need no new tuple.
    define direct_receive_work: [agent_principal, tool_principal, plugin_principal, tenant#member] or member from owner
    # ownership gate: accessible iff the caller's tenant has tenant_enabled for this component.
    # platform_enabled and tenant_published are operational markers enforced at write time
    # (operators only write tenant_enabled for platform-approved or tenant-published components).
    define in_tenant_catalog: member from tenant_enabled
    # Effective per-action evaluators. Preserving the existing relation names
    # means legacy Check(subject, can_read, component) call sites pick up the
    # deny-wins composition automatically.
    define can_execute: (direct_execute and in_tenant_catalog) but not any_execute_deny
    # can_use is the relation every HarnessCallbackService RPC is annotated
    # with (authz.rpc relation "can_use", object component:_system via the
    # system_tenant deriver): "may this principal use the platform backplane".
    # It is the execute right on the backplane component, nothing more. It was
    # missing, so ext-authz's Check was an OpenFGA validation error and every
    # off-cluster component callback (Observe, SubmitFinding, WorldView, ...)
    # died at the edge with "authorization service unavailable".
    define can_use: can_execute
    define can_configure: (direct_configure and in_tenant_catalog) but not any_write_deny
    define can_read: (direct_read and in_tenant_catalog) but not any_read_deny
    # Work-receive evaluators (ADR-0066). can_poll_work gates the receive-side
    # RPCs (ComponentService.PollWork / SubmitResult). It is satisfied by EITHER
    # the drive grant (can_execute — held by agent/tool principals) OR the narrow
    # receive grant (can_receive_work — held by plugin principals). So a plugin
    # may receive its dispatched work but may NOT drive the platform: the drive
    # RPCs (RunMission / CallTool / CreateMission) stay gated on can_execute,
    # which a plugin_principal never holds.
    define can_receive_work: (direct_receive_work and in_tenant_catalog) but not any_execute_deny
    define can_poll_work: can_execute or can_receive_work
    # Component-scope effective relations — evaluated when the caller is an
    # agent_principal. Each requires both the owner-side action (via can_*)
    # AND the per-component grant tuple. component_scope JWT claim narrowing
    # (R2) is enforced at the interceptor against these relations.
    define can_read_as_component: can_read and component_read_enabled
    define can_write_as_component: can_configure and component_write_enabled
    define can_execute_as_component: can_execute and component_execute_enabled
    define can_be_invoked_by: [agent_principal, component]

type system_tenant
  relations
    define platform_operator: [user]
    # parent: the set of tenants registered under the platform. Enumeration-only
    # (NOT referenced by any computed/authz relation) — it lets the catalog
    # fan-out reconciler list every tenant via
    # system_tenant:_system#parent@tenant:X to fan platform_enabled catalog
    # items out as tenant_enabled. Written at tenant provisioning. (deploy#782)
    define parent: [tenant]

type team
  relations
    define parent: [tenant]
    define admin: [user] or admin from parent
    define member: [user, team#admin]
    define can_view_data_from: [team]

# mission_definition — per-tenant container for structured mission definitions
# registered via gibson.daemon.v1.DaemonService/CreateMissionDefinition. The
# per-tenant singleton object is addressed as `mission_definition:_tenant_<slug>`
# and checked by the CreateMissionDefinition RPC authz rule. `writer` is granted
# only to users who are admin of the parent tenant — no direct user grants
# intended; contribute via tenant admin membership only.
#
# can_view / can_execute / can_list added under spec
# phase-1-daemon-critical-exfil-fixes (Task 4) so per-resource authz checks
# have a typed relation to bind against. Per-request tuples are NEVER written;
# the only writers are resource creation (Phase 2 provisioning hook) and the
# BackfillResourceParents routine in backfill.go (Phase 1 flag-gated off).
type mission_definition
  relations
    define parent: [tenant]
    define writer: admin from parent
    define can_view: member from parent
    define can_execute: member from parent
    define can_list: member from parent

# mission — a parameterised mission instance scoped to a tenant. Created via
# gibson.daemon.v1.DaemonService/CreateMission. `belongs_to` links the mission
# to its owning tenant; per-request authz checks bind against can_view /
# can_execute / can_list, and the mission-checkpointing R13/R14/R15/R16 RPCs
# bind against the mission-scoped `viewer` / `admin` relations. The legacy
# `parent` relation is preserved so existing `can_view` / `can_execute` /
# `can_list` callers (and previously written `parent` tuples) keep working
# — the new `belongs_to` relation is the canonical write target going forward
# and feeds the cascading viewer/admin relations.
#
# Cascading semantics:
#   - Every tenant member is automatically a mission viewer (read access).
#   - Every tenant admin is automatically a mission admin (rewind access).
#   - Per-mission grants (e.g. "share with this user") layer on top via the
#     direct [user, ...] entries.
#
# Per-request tuples are never written; tuples are produced only by mission
# creation (Phase 2A — see internal/daemon/api/server.go::CreateMission) and
# the BackfillResourceParents routine in backfill.go.
#
# Added under spec phase-1-daemon-critical-exfil-fixes Task 4; extended for
# spec mission-checkpointing R13/R14/R15/R16 (viewer/admin + checkpoint
# browser + rewind).
type mission
  relations
    define parent: [tenant]
    define belongs_to: [tenant]
    define admin: [user] or admin from belongs_to
    define viewer: [user] or admin or member from belongs_to
    define can_view: viewer or member from parent
    define can_execute: member from parent
    define can_list: viewer or member from parent
    define can_browse_checkpoints: viewer
    define can_rewind: admin

# run — a mission execution instance (invocation of a mission against a
# target) scoped to a tenant. Follows the same parent/relation shape as
# mission. Added under spec phase-1-daemon-critical-exfil-fixes Task 4.
type run
  relations
    define parent: [tenant]
    define can_view: member from parent
    define can_execute: member from parent
    define can_list: member from parent

# target — a scan target (system / endpoint / asset) scoped to a tenant.
# Follows the same parent/relation shape as mission. Added under spec
# phase-1-daemon-critical-exfil-fixes Task 4.
type target
  relations
    define parent: [tenant]
    define can_view: member from parent
    define can_execute: member from parent
    define can_list: member from parent

# finding — a security finding emitted by a mission run, scoped to a tenant.
# Read-only: findings are produced by tools/agents and consumed by the
# dashboard; there is no "execute a finding" operation. Added under spec
# phase-1-daemon-critical-exfil-fixes Task 4.
type finding
  relations
    define parent: [tenant]
    define can_view: member from parent
    define can_list: member from parent

# tenant_component — per-tenant view of a registered component (agent /
# tool / plugin) for resource-level authz. The existing `component` type
# (above) carries the catalog-gating and deny-wins access model; this
# tenant-parented companion type expresses "this component belongs to
# tenant X" so can_view / can_execute / can_register / can_list can be
# bound as simple member-from-parent relations. Added under spec
# phase-1-daemon-critical-exfil-fixes Task 4. The original `component`
# type is NOT modified — per task restrictions, existing tenant membership
# semantics are preserved.
type tenant_component
  relations
    define parent: [tenant]
    define can_view: member from parent
    define can_execute: member from parent
    define can_register: admin from parent
    define can_list: member from parent

# ----------------------------------------------------------------------
# LLM provider / model access gating — spec `llm-user-attribution-governance`
# ----------------------------------------------------------------------
#
# provider and model types enable per-user / per-team / per-tenant gating
# of slot resolution. Absent tuples = permit-all (backwards compatible
# with today's behavior); gating kicks in once any tuple exists.
#
# Tuple examples:
#   tenant:acme               | owner   | provider:anthropic
#   user:alice                | can_use | provider:anthropic
#   team:engineering#member   | can_use | provider:openai
#   tenant:acme#member        | can_use | provider:anthropic   (grant to all members)
#   provider:anthropic        | provider | model:claude-opus-4
#   role:senior               | can_use | model:claude-opus-4     (not yet wired)
#
# can_use on model is a computed-union: direct tuple OR inherited from
# the provider, so granting provider:anthropic:can_use to a user grants
# them every model on that provider automatically.

type provider
  relations
    define owner: [tenant]
    define can_use: [user, team#member, tenant#member]

type model
  relations
    define provider: [provider]
    define owner: [tenant]
    define can_use: [user, team#member, tenant#member] or can_use from provider

# ----------------------------------------------------------------------
# Secret resource type — spec `secrets-broker` Phase 8
# ----------------------------------------------------------------------
#
# `secret` represents a named opaque value governed by the SecretsBroker.
# The structural enforcement property: only plugin_principal callers may
# resolve (read plaintext) a secret. agent_principal and tool_principal
# have NO relation to secret — their absence from can_resolve is the
# structural gate, not just a policy default.
#
# Relation semantics:
#   belongs_to   — ties the secret to its owning tenant for scoped queries
#   can_resolve  — grants plaintext read-back; plugin_principal ONLY
#   can_write    — dashboard / admin CRUD (user direct or via tenant#admin)
#   can_delete   — dashboard / admin delete (user direct or via tenant#admin)
#
# Tuple shape written by tenant-operator at plugin_principal provisioning:
#   (plugin_principal:<install_id>, can_resolve, secret:tenant-<tenant_id>/*)
# (tenant-id and ref joined with "/", never ":" — gibson#1024, authz.TenantQualifiedSep)
#
# Per spec non-plugin-secret-isolation, the model definition below restricts
# can_resolve to [plugin_principal] ONLY. user-typed, agent_principal-typed,
# and tool_principal-typed can_resolve writes are REJECTED at insert time.
# The historical "user:<daemon_service_id> wildcard" tuple — formerly used
# for the LLM-provider-config resolution path — is intentionally absent.
# That path now routes through plugin_principal:llm-config with explicit
# per-name object IDs (no wildcard) — see spec
# secrets-blast-radius-reduction Layer 2.

type secret
  relations
    define belongs_to: [tenant]
    define can_resolve: [plugin_principal]
    define can_write: [user, tenant#admin]
    define can_delete: [user, tenant#admin]

# ----------------------------------------------------------------------
# Plugin resource type — spec `plugin-runtime` Phase 10 (Task 25)
# ----------------------------------------------------------------------
#
# `plugin` represents a registered plugin install reachable by tools via
# the `gibson.plugin.v1.PluginInvokeService.PluginInvoke` RPC. The RPC's
# authz annotation resolves the FGA object via `tenant_and_field('PluginName')`
# producing object IDs of the form `plugin:<tenant>:<plugin_name>` (see
# core/ext-authz/internal/fga/check.go:resolveObject). The relation checked
# at request time is `tool_principal#can_invoke@plugin:<tenant>:<plugin_name>`.
#
# Relation semantics:
#   belongs_to  — ties the plugin to its owning tenant for scoped queries
#   can_invoke  — grants tool_principal (or any tenant member) the ability
#                 to invoke this plugin's methods. agent_principal is
#                 intentionally excluded: agents dispatch tools; tools
#                 invoke plugins (per Requirement 5.2).
#
# Tuple shape written by tenant-operator at plugin registration (v1, tenant-wide):
#   (tenant:<tenant_id>#member, can_invoke, plugin:<tenant_id>:<plugin_name>)
#
# This grants every tenant member (including every tool_principal that
# inherits tenant membership) can_invoke on the registered plugin without
# enumerating per-(tool, plugin) pairs. Per-tool granular grants are
# out of scope for v1; the relation accepts `tool_principal` directly so
# fine-grained tuples can be added later without a model change.
#
# agent_principal is NOT in the can_invoke type list; absent direct grants
# combined with no computed-union path mean agents are structurally barred
# from invoking plugins.

type plugin
  relations
    define belongs_to: [tenant]
    define can_invoke: [tool_principal, tenant#member]

# bank — a pool of always-on coding agents with one owner (ADR-0019,
# gibson#1706). It is the object every BankService RPC authorizes against, and
# the parent a job inherits from.
#
# OWNERSHIP. `owner` is the relation the generated registry checks for
# UpdateBank, DeleteBank and the three sign-in RPCs, so it has to answer "who
# may manage this bank". A bank has exactly one owner, and the owner is either
# a person or the tenant: `owner` is the direct grant a person gets on the bank
# they created, and a tenant admin holds it on a bank the tenant owns
# (`tenant_owned`). A tenant-owned bank runs on the tenant's own provider
# configuration, so there is no personal subscription to protect; a person's
# bank is theirs alone and no tenant admin manages it.
#
# SENDING. `can_send` is who may open a job on this bank and send a turn to it.
# It is deliberately wider than ownership: a person builds a bank and lets a
# team, a mission or an agent feed it work. Every principal kind can hold it,
# because a job may be opened by a person from the console, by a mission node,
# or by another agent. The owner always holds it.
#
# READING. `can_read` is who may see the bank and list its members. Owning and
# sending both imply it: a caller that may drive a bank may see it.
type bank
  relations
    define parent: [tenant]
    # tenant_owned — written when the tenant owns the bank rather than a
    # person. It makes every tenant admin an owner of it.
    define tenant_owned: [tenant]
    # owner — who may manage this bank: change its size and policies, delete
    # it, and drive the sign-in of its members.
    define owner: [user] or admin from tenant_owned
    # can_send — open a job on this bank and send it input.
    define can_send: [user, agent_principal, tool_principal, plugin_principal, tenant#member, team#member] or owner
    # can_read — see the bank and list its members.
    define can_read: [user, tenant#member, team#member] or can_send or owner

# job — one unit of work a bank member holds (ADR-0019). Its parent is the
# bank, so the rights a caller has on the bank carry to the jobs on it and no
# per-job tuple is needed for the ordinary case.
#
# CLOSING is separate from sending on purpose. The worker never closes its own
# job: a scorer does. `can_close` is the bank's owner, the principal that
# opened the job, and any principal explicitly granted `scorer` — which is how
# the job node executor and a verification agent get the right for the one job
# they judge. It is NOT implied by can_send, or a member given `can_send` to
# ask a question could close the job it is working on.
type job
  relations
    define parent: [bank]
    # opened_by — the principal that opened the job. It may send and close.
    define opened_by: [user, agent_principal, tool_principal, plugin_principal]
    # scorer — a principal granted the right to judge THIS job: the job node
    # executor, or the verification agent the node names.
    define scorer: [user, agent_principal, tool_principal, plugin_principal]
    # can_send — send the next turn to the job.
    define can_send: opened_by or can_send from parent
    # can_close — close the job with a verdict and a score.
    define can_close: scorer or opened_by or owner from parent
    # can_read — read the job and follow its events.
    define can_read: opened_by or scorer or can_read from parent

# ----------------------------------------------------------------------
# Conditions — OpenFGA CEL predicates for contextual tuple evaluation.
# Added for instant-session-revocation (gibson#627).
# ----------------------------------------------------------------------
#
# OpenFGA 1.1 grammar requires all condition blocks to appear AFTER the
# last type definition (grammar rule: Main → ModelHeader → TypeDefs → Conditions).
# Do NOT move these blocks above any type definition.

# token_not_revoked — session-validity gate for instant revocation (gibson#627).
#
# When a session is revoked the daemon records a revoked_at timestamp.
# ext-authz (Slice 2) passes both timestamps as condition context on every
# FGA Check against the active_session relation. The CEL expression
# `token_issued_at > revoked_at` is true when the token was issued BEFORE
# the revocation event (i.e. the session is valid), and false once the
# revoked_at timestamp advances past the token_issued_at (session revoked).
#
# Timestamp comparison uses OpenFGA's built-in CEL timestamp type (RFC 3339).
# Both parameters are required on every Check call targeting active_session;
# a missing context value causes the condition to evaluate to false (deny).
#
# Spec: instant-session-revocation (gibson#627 Slice 1).
condition token_not_revoked(token_issued_at: timestamp, revoked_at: timestamp) {
  token_issued_at > revoked_at
}
